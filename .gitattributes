# Normalise text files to LF in the repo AND in working trees, regardless of core.autocrlf.
# Prettier enforces endOfLine: lf; without eol=lf, Windows checkouts get CRLF and format:check fails locally.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.ico binary
*.woff2 binary
