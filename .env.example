# SpendTrack build settings. Copy to .env.local (never committed) or set them on your host.
# They are read when the app is BUILT: rebuild or redeploy after any change. Every value ends up
# inside the app, readable by anyone who opens it: put no secrets here.
#
# Sync is optional. With URL and key blank the app is local-only and everything but sync works.
# To sync through your own Supabase project, follow docs/SELF_HOST.md (migrations 001 to 006 on a
# new, empty project, then these values).

# Project URL, from Supabase → Project Settings → Data API: https://<your-project-ref>.supabase.co
VITE_SUPABASE_URL=

# The "anon public" key or a publishable key (sb_publishable_…); never service_role or sb_secret_….
VITE_SUPABASE_ANON_KEY=

# rpc for a new project: sync only through the relay's functions, every new sync private (auto: old relays).
VITE_SYNC_RELAY=rpc

# Compare-and-set for table writes; leave blank with rpc (the functions always compare-and-set).
VITE_SYNC_CAS=

# "true" seeds sample entries on a first visit (a public demo); leave blank for your own copy.
VITE_DEMO_MODE=
