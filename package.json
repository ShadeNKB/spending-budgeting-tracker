{
  "name": "spendtrack",
  "private": true,
  "description": "A fast, local-first spending tracker with smart categorisation, real-time budgets, and optional cross-device sync.",
  "version": "0.7.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadeNKB/spending-budgeting-tracker.git"
  },
  "homepage": "https://github.com/ShadeNKB/spending-budgeting-tracker#readme",
  "bugs": {
    "url": "https://github.com/ShadeNKB/spending-budgeting-tracker/issues"
  },
  "keywords": [
    "spending-tracker",
    "expense-tracker",
    "budgeting",
    "personal-finance",
    "finance-dashboard",
    "local-first",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "ws": "^8.21.0",
    "tmp": "^0.2.6",
    "fast-uri": "^3.1.2",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{js,json,md}\"",
    "size": "node scripts/check-bundle-size.mjs",
    "a11y": "axe http://localhost:4173 --exit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  }
}
