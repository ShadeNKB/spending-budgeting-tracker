{
  "name": "spendtrack",
  "private": true,
  "description": "A fast, local-first spending tracker with smart categorisation, real-time budgets, and optional cross-device sync.",
  "version": "0.9.4",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadeNKB/spending-budgeting-tracker.git"
  },
  "homepage": "https://github.com/ShadeNKB/spending-budgeting-tracker#readme",
  "bugs": {
    "url": "https://github.com/ShadeNKB/spending-budgeting-tracker/issues"
  },
  "keywords": [
    "spending-tracker",
    "expense-tracker",
    "budgeting",
    "personal-finance",
    "finance-dashboard",
    "local-first",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "fast-uri": "^3.1.2",
    "@babel/plugin-transform-modules-systemjs": "^7.29.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-preview.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts,json,md}\"",
    "size": "node scripts/check-bundle-size.mjs",
    "size:relay": "node scripts/check-relay-weight.mjs",
    "check:backups": "node scripts/check-no-backups.mjs",
    "hooks:install": "node -e \"require('node:fs').chmodSync('.githooks/pre-commit', 0o755)\" && git config core.hooksPath .githooks",
    "a11y": "playwright test e2e/a11y.spec.ts e2e/keyboard.spec.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify": "npm run check:backups && npm run typecheck && npm run lint && npm run format:check && npm run test:run && npm run build && npm run size && npm run size:relay && npm run smoke"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-virtual": "^3.14.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.22",
    "axe-core": "4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.4"
  }
}
